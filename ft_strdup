char    *ft_strdup(const char *s1)
{
    char    *s2;
    size_t  s1len;
    size_t  i;

    if (!s1)
        return (NULL);
    i = 0;
    s1len = ft_strlen(s1) + 1;
    s2 = malloc(sizeof(char) * s1len);
    if (s2 == NULL)
        return (NULL);
    while (i < s1len)
    {
        s2[i] = s1[i];
        i++;
    }
    return (s2);
}
